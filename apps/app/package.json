{
  "name": "@basic-hosted-expense-tracker/app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "prebuild": "expo prebuild --clean",
    "start": "expo start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web --clear",
    "lint": "expo lint",
    "typecheck": "expo customize tsconfig.json && tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@basic-hosted-expense-tracker/server": "workspace:^",
    "@basic-hosted-expense-tracker/shared": "workspace:^",
    "@expo/html-elements": "^0.12.5",
    "@expo/metro-runtime": "~57.0.13",
    "@gluestack-ui/core": "^5.0.15",
    "@gluestack-ui/utils": "^5.0.6",
    "@hookform/resolvers": "^5.9.1",
    "@kinde/expo": "^0.8.1",
    "@react-native-vector-icons/material-design-icons": "^13.1.3",
    "@tanstack/react-query": "^5.102.3",
    "add": "^2.0.9",
    "expo": "~57.0.22",
    "expo-auth-session": "~57.0.12",
    "expo-constants": "~57.0.18",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "hono": "catalog:",
    "nativewind": "^5.0.0-rc.0",
    "react": "19.2.3",
    "react-aria": "^3.45.0",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.86.0",
    "react-native": "0.86.3",
    "react-native-css": "^3.1.0-rc.0",
    "react-native-nitro-modules": "^0.37.0",
    "react-native-paper": "^5.15.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-unistyles": "^3.3.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "react-stately": "^3.39.0",
    "tailwind-variants": "^0.1.20"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/react": "~19.2.4",
    "@types/react-dom": "~19.2.7",
    "babel-plugin-module-resolver": "^5.0.0",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^10.10.0",
    "eslint-config-expo": "~57.0.1",
    "jest": "^30.5.1",
    "jest-expo": "~57.0.5",
    "tailwindcss": "^4.2.0",
    "test-renderer": "^1.3.0",
    "typescript": "catalog:"
  },
  "jest": {
    "projects": [
      {
        "preset": "jest-expo/ios",
        "displayName": "ios",
        "setupFilesAfterEnv": [
          "<rootDir>/test/setup.ts"
        ],
        "moduleNameMapper": {
          "\\.(css)$": "<rootDir>/test/mocks/styleMock.js",
          "^@/app/(.*)$": "<rootDir>/src/$1",
          "^@/(.*)$": "<rootDir>/$1"
        },
        "transformIgnorePatterns": [
          "node_modules/(?!(?:.pnpm/)?((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|native-base|react-native-svg|nativewind|react-native-css|react-native-unistyles|@gluestack-ui/.*|react-native-paper|@react-native-vector-icons/.*|react-native-reanimated|react-native-worklets|standard-navigation|expo-router))"
        ],
        "testMatch": [
          "<rootDir>/test/**/*.test.[jt]s?(x)"
        ],
        "testPathIgnorePatterns": [
          "\\.web\\.test\\.[jt]sx?$"
        ]
      },
      {
        "preset": "jest-expo/android",
        "displayName": "android",
        "setupFilesAfterEnv": [
          "<rootDir>/test/setup.ts"
        ],
        "moduleNameMapper": {
          "\\.(css)$": "<rootDir>/test/mocks/styleMock.js",
          "^@/app/(.*)$": "<rootDir>/src/$1",
          "^@/(.*)$": "<rootDir>/$1"
        },
        "transformIgnorePatterns": [
          "node_modules/(?!(?:.pnpm/)?((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|native-base|react-native-svg|nativewind|react-native-css|react-native-unistyles|@gluestack-ui/.*|react-native-paper|@react-native-vector-icons/.*|react-native-reanimated|react-native-worklets|standard-navigation|expo-router))"
        ],
        "testMatch": [
          "<rootDir>/test/**/*.test.[jt]s?(x)"
        ],
        "testPathIgnorePatterns": [
          "\\.web\\.test\\.[jt]sx?$"
        ]
      },
      {
        "preset": "jest-expo/web",
        "displayName": "web",
        "setupFilesAfterEnv": [
          "<rootDir>/test/setup.ts"
        ],
        "moduleNameMapper": {
          "\\.(css)$": "<rootDir>/test/mocks/styleMock.js",
          "^@/app/(.*)$": "<rootDir>/src/$1",
          "^@/(.*)$": "<rootDir>/$1"
        },
        "transformIgnorePatterns": [
          "node_modules/(?!(?:.pnpm/)?((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|native-base|react-native-svg|nativewind|react-native-css|react-native-unistyles|@gluestack-ui/.*|react-native-paper|@react-native-vector-icons/.*|react-native-reanimated|react-native-worklets|standard-navigation|expo-router))"
        ],
        "testMatch": [
          "<rootDir>/test/**/*.web.test.[jt]s?(x)"
        ]
      }
    ]
  }
}
