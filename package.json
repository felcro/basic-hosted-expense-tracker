{
  "name": "basic-hosted-expense-tracker",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "drizzle-orm": "^1.0.0-rc.4",
      "drizzle-kit": "^1.0.0-rc.4",
      "hono": "^4.13.3",
      "typescript": "~6.0.3",
      "zod": "^4.5.4"
    }
  },
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "build:web": "cd apps/app && bun x expo export -p web && bun scripts/precompress.ts",
    "start": "cd apps/server && bun serve.ts",
    "fmt": "oxfmt",
    "lint": "oxfmt --check && oxlint",
    "lint:fix": "oxfmt && oxlint --fix",
    "typecheck": "bun run --filter '*' typecheck",
    "app": "bun run --filter '*' start",
    "android": "bun run --filter '*' android",
    "ios": "bun run --filter '*' ios",
    "web": "bun run --filter '*' web",
    "server": "bun run --filter '*' server",
    "dev": "bun run --filter '*' devserver",
    "test": "bun run --filter '*' test",
    "test:integration": "bun run --filter '@basic-hosted-expense-tracker/server' test:integration",
    "test:all": "bun run test && bun run test:integration",
    "test:e2e": "bunx argent flow run e2e/flows"
  },
  "devDependencies": {
    "@nkzw/eslint-plugin": "^2.0.0",
    "@nkzw/oxlint-config": "^1.2.1",
    "@swmansion/argent": "^0.25.1",
    "@types/bun": "latest",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001"
  },
  "peerDependencies": {
    "typescript": "catalog:"
  },
  "resolutions": {
    "lightningcss": "1.30.1"
  },
  "overrides": {
    "lightningcss": "1.30.1",
    "metro": "0.84.5"
  }
}
